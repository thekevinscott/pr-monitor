{
  "name": "pr-monitor",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that gates on aggregate PR check status",
  "type": "module",
  "files": [
    "action.yml",
    "src",
    "!src/**/*.test.ts"
  ],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "drift": "tsx src/drift/entry.ts",
    "promote": "tsx src/promote/entry.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "testing-conventions": "^0.0.98",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "@octokit/rest": "^22.0.1",
    "tsx": "^4.22.4",
    "willfire": "^0.1.31"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
