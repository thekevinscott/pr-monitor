{
  "name": "pr-monitor",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that gates on aggregate PR check status",
  "type": "module",
  "files": [
    "action.yml",
    "src",
    "!src/**/*.test.ts"
  ],
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "promote": "tsx src/promote/entry.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.0",
    "testing-conventions": "^0.0.147",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@octokit/rest": "^22.0.1",
    "tsx": "^4.22.4",
    "willfire": "workspace:*"
  }
}
